{% comment %}
  SAN PHAM BAN CHAY - GRID 4 COT
  - Lay danh muc tu cau hinh giao dien, fallback sang frontpage.
  - Dung product-grid-item de giu giao dien va chuc nang gio hang.
  - Thu ung dung Thong ke san pham qua product.id; KHONG chac ung dung
    ho tro hien thi ngoai trang chi tiet san pham.
  - Chua tu xep hang theo luot mua; thu tu theo danh muc duoc chon.
{% endcomment %}

{% include 'ttb-home-product-styles' %}

{% assign bestsell_alias = settings.sec_feature_product_col %}
{% if bestsell_alias == blank or bestsell_alias == 'None' %}
  {% assign bestsell_alias = 'frontpage' %}
{% endif %}

{% assign bestsell_collection = collections[bestsell_alias] %}
{% if bestsell_collection == blank or bestsell_collection.products.size == 0 %}
  {% assign bestsell_collection = collections['frontpage'] %}
{% endif %}

{% assign bestsell_limit = 8 %}
{% assign bestsell_shown = 0 %}

<section class="section_bestsell" aria-labelledby="bestsell-heading">
  <div class="container">
    <div class="bestsell-heading">
      <h2 id="bestsell-heading">Sản phẩm bán chạy</h2>
      {% if bestsell_collection != blank and bestsell_collection.products.size > 0 %}
        <a class="bestsell-view-all" href="{{ bestsell_collection.url }}">Xem tất cả</a>
      {% endif %}
    </div>

    {% if bestsell_collection != blank and bestsell_collection.products.size > 0 %}
      <div class="bestsell-grid">
        {% for product in bestsell_collection.products %}
          {% if bestsell_shown < bestsell_limit and product.available and product.variants.size == 1 and product.price_min > 0 %}
            {% assign bestsell_shown = bestsell_shown | plus: 1 %}
            <div class="item bestsell-grid-item">
              {% include 'product-grid-item' %}

              {% comment %}
                THU NGHIEM: ung dung ABPS co tu lay thong ke cho product.id
                khi o trang chu khong? Neu khong, div nay se de trong.
              {% endcomment %}
              <div class="abps-productdetail bestsell-abps"
                   ab-data-productid="{{ product.id }}"></div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if bestsell_shown == 0 %}
        <p class="bestsell-empty">Danh mục hiện chưa có sản phẩm đáp ứng điều kiện hiển thị.</p>
      {% endif %}
    {% else %}
      <p class="bestsell-empty">Chưa tìm thấy danh mục sản phẩm. Kiểm tra thiết lập danh mục sản phẩm nổi bật trong giao diện Sapo.</p>
    {% endif %}
  </div>
</section>

<style>
/* Chi ap dung cho khu vuc bestsell, khong su dung Owl Carousel. */
.section_bestsell { padding: 24px 0 30px; }
.section_bestsell .bestsell-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid #e5e5e5;
}
.section_bestsell .bestsell-heading h2 {
  margin: 0;
  font-size: 22px;
  line-height: 1.35;
  font-weight: 700;
}
.section_bestsell .bestsell-view-all { flex: 0 0 auto; font-size: 14px; }
.section_bestsell .bestsell-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  align-items: stretch;
}
.section_bestsell .bestsell-grid > .bestsell-grid-item {
  min-width: 0;
  width: auto !important;
  max-width: none !important;
  margin: 0 !important;
  float: none !important;
}
.section_bestsell .bestsell-grid-item img { max-width: 100%; height: auto; }
.section_bestsell .bestsell-abps:empty { display: none; }
.section_bestsell .bestsell-abps { margin-top: 8px; font-size: 12px; }
.section_bestsell .bestsell-empty { padding: 12px 0; color: #666; }
@media (max-width: 991px) {
  .section_bestsell .bestsell-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
}
@media (max-width: 480px) {
  .section_bestsell { padding: 18px 0 22px; }
  .section_bestsell .bestsell-heading { gap: 8px; margin-bottom: 12px; }
  .section_bestsell .bestsell-heading h2 { font-size: 18px; }
  .section_bestsell .bestsell-view-all { font-size: 12px; }
  .section_bestsell .bestsell-grid { gap: 8px; }
}
</style>
