<div class="collections_des_and_menu margin-top-10">
	<div class="collections_des_and_menu-content js-collection-desc">
		{% if page_title != "Tất cả sản phẩm" %}
		{{ collection.description }}
		{% else %}
		{{ settings.aside_category_intro_content }}
		{% endif %}
	</div>

	<button type="button" class="toggle-desc-btn">
		Xem thêm
	</button>

	{% if page_title != "Tất cả sản phẩm" %}
	{% if link_alias == null %}
	{% assign link_alias = settings.aside_category_menu %}
	{% endif %}
	{% comment %}
		Lưới danh mục có ảnh (D&T 29/10/2026). Ảnh lấy theo thứ tự:
		1) Ảnh của danh mục (Sapo Admin > Sản phẩm > Danh mục > chọn danh mục > Ảnh danh mục)
		2) Nếu chưa có: ảnh sản phẩm đầu tiên trong danh mục
		3) Nếu vẫn không có: hiện biểu tượng mặc định
	{% endcomment %}
	{{ 'ttb-category-cards.css' | asset_url | stylesheet_tag }}
	<div class="ttb-cat">
		<h2 class="ttb-cat__heading">Danh mục sản phẩm</h2>
		<ul class="ttb-cat__grid">
			{% for link in linklists[link_alias].links %}
			{% assign ttb_cat_img = '' %}
			{% if link.object.image %}
				{% assign ttb_cat_img = link.object.image.src | img_url: 'medium' %}
			{% elsif link.object.products.first.featured_image %}
				{% assign ttb_cat_img = link.object.products.first.featured_image.src | img_url: 'medium' %}
			{% endif %}
			<li class="ttb-cat__item{% if link.active %} active{% endif %}">
				<a href="{{ link.url }}" class="ttb-cat__link" title="{{ link.title | escape }}">
					<span class="ttb-cat__img">
						{% if ttb_cat_img != '' %}
						<img src="{{ ttb_cat_img }}" alt="{{ link.title | escape }}" loading="lazy" decoding="async">
						{% else %}
						<span class="ttb-cat__letter"><i class="fa fa-th-large" aria-hidden="true"></i></span>
						{% endif %}
					</span>
					<span class="ttb-cat__name">{{ link.title }}</span>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
	{% endif %}
</div>

<style>
.collections_des_and_menu-content {
	max-height: 200px;
	overflow: hidden;
	position: relative;
	transition: all 0.3s ease;
}

.collections_des_and_menu-content.active {
	max-height: 100000px;
}

.toggle-desc-btn {
    background: #be2326;
    color: #fff;
    cursor: pointer;
    font-weight: 600;
    padding: 5px 15px;
    margin: 0 auto;
	  margin-top: 10px;
    text-align: center;
    display: block;
    border: 1px solid #be2326;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
	const desc = document.querySelector(".js-collection-desc");
	const btn = document.querySelector(".toggle-desc-btn");

	if(desc && btn){

		// Ẩn nút nếu nội dung ngắn
		if(desc.scrollHeight <= 200){
			btn.style.display = "none";
		}

		btn.addEventListener("click", function () {

			desc.classList.toggle("active");

			if(desc.classList.contains("active")){
				btn.innerText = "Thu gọn";
			}else{
				btn.innerText = "Xem thêm";
			}

		});
	}
});
</script>
