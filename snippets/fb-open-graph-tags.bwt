{% comment %}
  THẺ OPEN GRAPH - thông tin Zalo, Messenger, Facebook, X... đọc khi khách dán / chia sẻ link
  (ảnh xem trước, tiêu đề, mô tả). Cập nhật D&T 13/11/2026.
{% endcomment %}
{% assign og_img = '' %}
{% assign og_desc = page_description | strip_html | strip_newlines | truncate: 200 %}
{% if template contains 'product' %}
	{% assign og_type = 'product' %}
	{% assign og_title = product.name | strip_html %}
	{% if og_desc == blank %}{% assign og_desc = product.content | strip_html | strip_newlines | truncate: 200 %}{% endif %}
	{% if product.featured_image %}{% assign og_img = product.featured_image.src | img_url: '1024x1024' %}{% endif %}
{% elsif template contains 'article' %}
	{% assign og_type = 'article' %}
	{% assign og_title = article.title | strip_html %}
	{% if og_desc == blank %}{% assign og_desc = article.summary_or_content | strip_html | strip_newlines | truncate: 200 %}{% endif %}
	{% assign img_tag = '<' | append: 'img' %}
	{% if article.image.src %}
		{% assign og_img = article.image.src | img_url: '1024x1024' %}
	{% elsif article.content contains img_tag %}
		{% assign og_src = article.content | split: 'src="' %}
		{% assign og_img = og_src[1] | split: '"' | first %}
	{% endif %}
{% elsif template contains 'collection' %}
	{% assign og_type = 'website' %}
	{% assign og_title = collection.title | strip_html %}
	{% if og_desc == blank %}{% assign og_desc = collection.description | strip_html | strip_newlines | truncate: 200 %}{% endif %}
	{% if collection.image %}{% assign og_img = collection.image.src | img_url: '1024x1024' %}{% endif %}
{% else %}
	{% assign og_type = 'website' %}
	{% assign og_title = page_title | strip_html %}
{% endif %}
{% if og_img == '' or og_img == blank %}{% assign og_img = 'logo.png' | asset_url %}{% endif %}
{% assign og_img = og_img | remove: 'https:' | remove: 'http:' %}
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ store.name | escape }}">
<meta property="og:locale" content="vi_VN">
<meta property="og:image" content="https:{{ og_img }}">
<meta property="og:image:secure_url" content="https:{{ og_img }}">
<meta property="og:image:alt" content="{{ og_title | escape }}">
{% if template contains 'product' %}
<meta property="og:price:amount" content="{{ product.price | money_without_currency }}">
<meta property="og:price:currency" content="{{ store.currency }}">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">
<meta name="twitter:image" content="https:{{ og_img }}">
