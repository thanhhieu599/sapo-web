{% include 'breadcrumb' %}
{% assign sb = settings.collection_layout %}
{% assign group_key = 'nhom-' | append: collection.handle %}
<style>
	:root{--t5-accent:#e53935;--t5-dark:#1f2937}
	/* ===== Tiêu đề danh mục ===== */
	.cl-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 18px;padding-bottom:12px;border-bottom:1px solid #eee}
	.cl-head .cl-title{margin:0;font-size:24px;font-weight:700;line-height:1.3;text-align:left;padding-left:12px;border-left:4px solid var(--t5-accent)}
	.cl-head .cl-count{font-size:13px;color:#666;background:#f4f5f7;border-radius:999px;padding:4px 12px;white-space:nowrap}
	@media(max-width:767px){.cl-head .cl-title{font-size:20px}}
	/* ===== Top 5 bán chạy ===== */
	.top5{margin:0 0 28px;padding:18px 16px 16px;border-radius:14px;background:linear-gradient(180deg,#fff6f5 0%,#fff 70%);border:1px solid #fde1de}
	.top5-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:10px}
	.top5-title{margin:0;font-size:18px;font-weight:700;color:var(--t5-dark);display:flex;align-items:center;gap:8px}
	.top5-title .fire{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:var(--t5-accent);color:#fff;font-size:15px}
	.top5-sub{font-size:12px;color:#6b7280}
	.top5-list{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
	.t5-card{position:relative;background:#fff;border:1px solid #eceff3;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s,border-color .2s}
	.t5-card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(17,24,39,.10);border-color:#f3b4af}
	.t5-rank{position:absolute;top:8px;left:8px;z-index:2;min-width:26px;height:26px;padding:0 6px;border-radius:8px;background:var(--t5-dark);color:#fff;font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center}
	.t5-card:nth-child(1) .t5-rank{background:#f59e0b}
	.t5-card:nth-child(2) .t5-rank{background:#94a3b8}
	.t5-card:nth-child(3) .t5-rank{background:#b45309}
	.t5-sale{position:absolute;top:8px;right:8px;z-index:2;background:var(--t5-accent);color:#fff;font-size:11px;font-weight:700;padding:3px 7px;border-radius:6px}
	.t5-img{display:block;aspect-ratio:1/1;background:#f8fafc}
	.t5-img img{width:100%;height:100%;object-fit:contain;display:block;padding:8px}
	.t5-body{padding:10px 10px 12px;display:flex;flex-direction:column;gap:6px;flex:1}
	.t5-name{margin:0;font-size:13px;line-height:1.4;font-weight:600;height:2.8em;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
	.t5-name a{color:var(--t5-dark);text-decoration:none}
	.t5-name a:hover{color:var(--t5-accent)}
	.t5-price{margin-top:auto;display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}
	.t5-price .now{color:var(--t5-accent);font-weight:700;font-size:15px}
	.t5-price del{color:#9ca3af;font-size:12px}
	.t5-out{font-size:11px;color:#6b7280}
	.t5-skel{height:230px;border-radius:12px;background:linear-gradient(90deg,#f1f3f6 25%,#e8ebf0 37%,#f1f3f6 63%);background-size:400% 100%;animation:t5shimmer 1.3s ease infinite}
	@keyframes t5shimmer{0%{background-position:100% 50%}100%{background-position:0 50%}}
	@media(prefers-reduced-motion:reduce){.t5-skel{animation:none}.t5-card{transition:none}}
	@media(max-width:991px){
		.top5{padding:14px 0 12px 12px;border-radius:12px}
		.top5-list{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;padding:0 12px 6px 0;-webkit-overflow-scrolling:touch;scrollbar-width:none}
		.top5-list::-webkit-scrollbar{display:none}
		.top5-list>*{flex:0 0 42%;scroll-snap-align:start}
	}
	@media(max-width:575px){.top5-list>*{flex-basis:62%}.top5-title{font-size:16px}}
</style>
<div class="container">
	<div class="row">
		<aside class="sidebar {{sb}} left-content col-md-3 col-sm-12 col-xs-12">
			{% include 'sidebar-collection' %}
		</aside>
		<section class="main_container collection col-md-9 col-sm-12 col-xs-12">
			{% comment %}{% include 'gallery_collections' %}{% endcomment %}
			<div class="pottion">
				<header class="cl-head">
					<h1 class="title-head cl-title">{% if page_title == 'All' %}Tất cả sản phẩm{% else %}{{ page_title }}{% endif %}</h1>
					{% if collection.products_count > 0 %}<span class="cl-count">{{ collection.products_count }} sản phẩm</span>{% endif %}
				</header>

				{% unless collection.handle == 'all' %}
				<section class="top5" id="top5-bestseller" data-url="{{ collection.url }}?view=top5&sort_by=best-selling" aria-label="Top 5 sản phẩm bán chạy nhất">
					<div class="top5-head">
						<h2 class="top5-title"><span class="fire" aria-hidden="true">&#128293;</span>Top 5 bán chạy nhất</h2>
					</div>
					<div class="top5-list" id="top5-list">
						<div class="t5-skel"></div><div class="t5-skel"></div><div class="t5-skel"></div><div class="t5-skel"></div><div class="t5-skel"></div>
					</div>
				</section>
				<script>
				(function () {
					var box = document.getElementById('top5-bestseller');
					if (!box) return;
					var m = location.search.match(/[?&]page=(\d+)/);
					if (m && parseInt(m[1], 10) > 1) { box.parentNode.removeChild(box); return; }
					var list = document.getElementById('top5-list');
					var url = box.getAttribute('data-url');
					var key = 'top5:' + url;
					var TTL = 10 * 60 * 1000;
					function render(html) {
						var doc = new DOMParser().parseFromString(html, 'text/html');
						var data = doc.querySelector('.top5-data');
						if (!data || !data.children.length) { box.parentNode.removeChild(box); return; }
						list.innerHTML = data.innerHTML;
					}
					try {
						var c = JSON.parse(sessionStorage.getItem(key) || 'null');
						if (c && Date.now() - c.t < TTL) { render(c.h); return; }
					} catch (e) {}
					fetch(url, { credentials: 'same-origin' })
						.then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
						.then(function (html) {
							try { sessionStorage.setItem(key, JSON.stringify({ t: Date.now(), h: html })); } catch (e) {}
							render(html);
						})
						.catch(function () { box.parentNode.removeChild(box); });
				})();
				</script>
				{% endunless %}

				{% if linklists[group_key].links.size > 0 %}
				{% include 'brand-subcategories' %}
				{% else %}
				<div class="category-products products clearfix">
					{% paginate collection.products by settings.collection_number_product %}
					{% include 'collection-sortby' %}
					{% if collection.products.size > 0 %}
					{% include 'products-grid-item' %}
					{% else %}
					<div class="alert alert-warning alert-dismissible fade in" role="alert">
						<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
						Sản phẩm đang được cập nhật. Vui lòng quay lại sau.
					</div>
					{% endif %}
					{% endpaginate %}
				</div>
				{% endif %}
				{% include 'collections_des_and_menu' %}
				{% comment %}===== TIN TỨC LIÊN QUAN DANH MỤC (D&T 13/11/2026) - cùng giao diện khối Tin tức mới ở trang chủ. Hiện 3 bài, ưu tiên bài có tag trùng tên danh mục, thiếu thì lấy bài mới nhất ====={% endcomment %}
				{% assign ttb_nb = blogs[settings.sec_new_blog] %}
				{% if ttb_nb and ttb_nb.articles.size > 0 %}
				{% assign ttb_limit = 3 %}
				{% assign ttb_ctitle = collection.title | downcase %}
				{% assign ttb_ids = '|' %}
				{% assign ttb_rel = 0 %}

				{% comment %}Bước 1: tìm bài liên quan{% endcomment %}
				{% for article in ttb_nb.articles %}
					{% if ttb_rel >= ttb_limit %}{% break %}{% endif %}
					{% assign ttb_match = false %}
					{% for tag in article.tags %}
						{% assign ttb_tag_h = tag | handleize %}
						{% if ttb_tag_h == collection.handle %}{% assign ttb_match = true %}{% break %}{% endif %}
					{% endfor %}
					{% unless ttb_match %}
						{% assign ttb_atitle = article.title | downcase %}
						{% if ttb_ctitle != blank and ttb_atitle contains ttb_ctitle %}{% assign ttb_match = true %}{% endif %}
					{% endunless %}
					{% if ttb_match %}
						{% assign ttb_ids = ttb_ids | append: article.url | append: '|' %}
						{% assign ttb_rel = ttb_rel | plus: 1 %}
					{% endif %}
				{% endfor %}

				<style>
					.ttb-collection-news{margin:25px 0 10px}
					.ttb-collection-news .barbox{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #eee}
					.ttb-collection-news .titlecate{margin:0;font-size:18px;font-weight:700}
					.ttb-collection-news .viewmoretext{white-space:nowrap;font-weight:600}
					.ttb-news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
					.ttb-news-grid .blog-item{margin:0;height:100%;border:1px solid #eee;border-radius:6px;overflow:hidden;background:#fff}
					.ttb-news-grid .blog-item-thumbnail{height:auto!important;aspect-ratio:16/10;overflow:hidden;background:#f6f6f6}
					.ttb-news-grid .blog-item-thumbnail img{width:100%;height:100%;object-fit:cover;display:block}
					.ttb-news-grid .blog-item-contens{padding:0 12px 12px!important}
					.ttb-news-grid .blog-item-name{font-size:15px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
					.ttb-news-grid .blog-item-summary{font-size:13px;line-height:1.55;color:#555;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
					@media(max-width:767px){
						.ttb-news-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;padding-bottom:6px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
						.ttb-news-grid::-webkit-scrollbar{display:none}
						.ttb-news-grid>.item{flex:0 0 82%;scroll-snap-align:start}
					}
				</style>
				<section class="section-news ttb-collection-news">
									<div class="box-shock">
										<div class="barbox clearfix">
											<h2 class="titlecate">{% if ttb_rel > 0 %}Kiến thức &amp; tin tức về {{ collection.title }}{% else %}{{ settings.sec_new_title }}{% endif %}</h2>
											<a href="{{ ttb_nb.url }}" class="viewmoretext" title="Xem tất cả">Xem tất cả</a>
										</div>
										<div class="list-blogs-link">
											<div class="ttb-news-grid">
												{% assign ttb_shown = 0 %}
												{% comment %}Bước 2: bài liên quan trước, rồi bài mới nhất cho đủ số lượng{% endcomment %}
												{% for ttb_pass in (1..2) %}
												{% for article in ttb_nb.articles %}
													{% if ttb_shown >= ttb_limit %}{% break %}{% endif %}
													{% assign ttb_key = '|' | append: article.url | append: '|' %}
													{% assign ttb_is_rel = false %}
													{% if ttb_ids contains ttb_key %}{% assign ttb_is_rel = true %}{% endif %}
													{% assign ttb_show = false %}
													{% if ttb_pass == 1 and ttb_is_rel %}{% assign ttb_show = true %}{% endif %}
													{% if ttb_pass == 2 and ttb_is_rel == false %}{% assign ttb_show = true %}{% endif %}
													{% if ttb_show %}
													{% assign ttb_shown = ttb_shown | plus: 1 %}
												<div class="item">
													<article class="blog-item">
														<div class="blog-item-thumbnail">
															<a href="{{ article.url }}">
																{% if article.image == null %}
																<img src="{{ 'no-image.jpg' | asset_url }}" alt="{{ article.title | escape }}" loading="lazy">
																{% else %}
																<img src="{{ article.image.src | img_url: 'large' }}" alt="{{ article.title | escape }}" class="img-responsive center-block" loading="lazy" decoding="async" />
																{% endif %}
															</a>
														</div>
														<div class="blog-item-contens">
															<h3 class="blog-item-name margin-top-10"><a href="{{ article.url }}" title="{{ article.title | escape }}">{{ article.title }}</a></h3>
															<div class="post-time">
																<span>Đăng bởi <b>{{ article.author }}</b> - {{ article.created_on | date: 'dd/MM/yyyy' }}</span>
															</div>
															<p class="blog-item-summary margin-bottom-5">{{ article.summary_or_content | strip_html | truncate: 100 }}</p>
														</div>
													</article>
												</div>
													{% endif %}
												{% endfor %}
												{% endfor %}
											</div>
										</div>
									</div>
				</section>
				{% endif %}
				{% comment %}===== HẾT KHỐI TIN TỨC ====={% endcomment %}
			</div>
		</section>
	</div>
</div>
{% include 'appbulk-selling-products' %}
<div class="ab-most-view-product-module ab-hide"></div>
