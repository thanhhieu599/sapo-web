{% include 'breadcrumb' %}
<div class="art-progress" id="artProgress"></div>

<div class="container article-wraper">
	<div class="row">
		<section class="right-content {%if settings.blog_layout == 'no'%}col-md-12{%else%}col-md-9{%endif%} {%if settings.blog_layout == 'left'%}col-md-push-3{%endif%}">
			<article class="article-main art-article" itemscope itemtype="http://schema.org/Article">
				{% if article.image.src %}
				{% assign featured_image = article.image.src %}
				{% else %}
				{% assign featured_image = 'logo.png' | asset_url %}
				{% endif %}
				<meta itemprop="mainEntityOfPage" content="{{ article.url }}">
				<meta itemprop="description" content="{{ article.summary | strip_html }}">
				<meta itemprop="author" content="{{ article.author }}">
				<meta itemprop="headline" content="{{ article.title }}">
				<meta itemprop="image" content="https:{{ featured_image }}">
				<meta itemprop="datePublished" content="{{ article.published_on | date: 'dd-MM-yyyy' }}">
				<meta itemprop="dateModified" content="{{ article.created_on | date: 'dd-MM-yyyy' }}">
				<div class="hidden" itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
					<div itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
						<img src="{{'logo.png'|asset_url}}" alt="{{ store.name }}"/>
						<meta itemprop="url" content="https:{{'logo.png'| asset_url }}">
						<meta itemprop="width" content="200">
						<meta itemprop="height" content="49">
					</div>
					<meta itemprop="name" content="{{ article.title }}">
				</div>

				<!-- ===== Đầu bài ===== -->
				<header class="art-header">
					{% if blog.name != blank %}
					<a class="art-eyebrow" href="{{ blog.url }}">{{ blog.name }}</a>
					{% endif %}
					<h1 class="art-title">{{ article.title }}</h1>
					<div class="art-meta">
						{% if article.author != blank %}<span><i class="fa fa-user-o" aria-hidden="true"></i> {{ article.author }}</span>{% endif %}
						<span><i class="fa fa-calendar-o" aria-hidden="true"></i> {{ article.created_on | date:'dd/MM/yyyy' }}</span>
						<span id="artRead" style="display:none;"><i class="fa fa-clock-o" aria-hidden="true"></i> <b></b> phút đọc</span>
					</div>
				</header>

				<!-- ===== Nội dung ===== -->
				<div class="article-details">
					<div class="article-content">
						<nav class="art-toc" id="artToc" style="display:none;">
							<p class="art-toc-title">Nội dung bài viết</p>
							<ol></ol>
						</nav>
						<div class="rte art-content" id="artContent">
							{{ article.content }}
						</div>
					</div>
				</div>

				<!-- ===== Tags + chia sẻ ===== -->
				{% if article.tags.size > 0 and settings.article_tags_enable %}
				<div class="art-tags">
					<span class="art-tags-label">Tags:</span>
					{% for tag in article.tags %}
					<a href="/blogs/all/tagged/{{ tag | handle }}" title="{{tag}}">{{tag}}</a>
					{% endfor %}
				</div>
				{% endif %}

				{% if settings.article_social_enable %}
				{% comment %}===== CHIA SẺ BÀI VIẾT (D&T 13/11/2026): nút Chia sẻ mở bảng chia sẻ của điện thoại (Zalo, Messenger, Tin nhắn...) ====={% endcomment %}
				{% capture ttb_share_url %}https:{{ store.url }}{{ article.url }}{% endcapture %}
				<div class="art-sharebar" data-share-url="{{ ttb_share_url }}" data-share-title="{{ article.title | escape }}" data-share-text="{{ article.summary_or_content | strip_html | strip_newlines | truncate: 120 | escape }}">
					<span class="art-sharebar-label">Chia sẻ bài viết:</span>
					<ul class="social art-social">
						<li class="share-native">
							<button type="button" class="art-share-btn" data-share-native aria-label="Chia sẻ bài viết">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11A2.99 2.99 0 0 0 21 5a3 3 0 1 0-5.91.7L8.04 9.81A3 3 0 1 0 6 15a2.99 2.99 0 0 0 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65A2.92 2.92 0 1 0 18 16.08z"/></svg>
								<span>Chia sẻ</span>
							</button>
						</li>
						<li class="fb">
							<a href="https://www.facebook.com/sharer/sharer.php" data-share-net="fb" target="_blank" rel="nofollow noopener" aria-label="Chia sẻ lên Facebook" title="Chia sẻ lên Facebook">
								<svg viewBox="0 0 96.124 96.123" aria-hidden="true"><path d="M72.089,0.02L59.624,0C45.62,0,36.57,9.285,36.57,23.656v10.907H24.037c-1.083,0-1.96,0.878-1.96,1.961v15.803c0,1.083,0.878,1.96,1.96,1.96h12.533v39.876c0,1.083,0.877,1.96,1.96,1.96h16.352c1.083,0,1.96-0.878,1.96-1.96V54.287h14.654c1.083,0,1.96-0.877,1.96-1.96l0.006-15.803c0-0.52-0.207-1.018-0.574-1.386c-0.367-0.368-0.867-0.575-1.387-0.575H56.842v-9.246c0-4.444,1.059-6.7,6.848-6.7l8.397-0.003c1.082,0,1.959-0.878,1.959-1.96V1.98C74.046,0.899,73.17,0.022,72.089,0.02z"/></svg>
							</a>
						</li>
						<li class="tt">
							<a href="https://twitter.com/intent/tweet" data-share-net="x" target="_blank" rel="nofollow noopener" aria-label="Chia sẻ lên X (Twitter)" title="Chia sẻ lên X (Twitter)">
								<svg viewBox="0 0 512 512" aria-hidden="true"><path d="M512,97.248c-19.04,8.352-39.328,13.888-60.48,16.576c21.76-12.992,38.368-33.408,46.176-58.016c-20.288,12.096-42.688,20.64-66.56,25.408C411.872,60.704,384.416,48,354.464,48c-58.112,0-104.896,47.168-104.896,104.992c0,8.32,0.704,16.32,2.432,23.936c-87.264-4.256-164.48-46.08-216.352-109.792c-9.056,15.712-14.368,33.696-14.368,53.056c0,36.352,18.72,68.576,46.624,87.232c-16.864-0.32-33.408-5.216-47.424-12.928c0,0.32,0,0.736,0,1.152c0,51.008,36.384,93.376,84.096,103.136c-8.544,2.336-17.856,3.456-27.52,3.456c-6.72,0-13.504-0.384-19.872-1.792c13.6,41.568,52.192,72.128,98.08,73.12c-35.712,27.936-81.056,44.768-130.144,44.768c-8.608,0-16.864-0.384-25.12-1.44C46.496,446.88,101.6,464,161.024,464c193.152,0,298.752-160,298.752-298.688c0-4.64-0.16-9.12-0.384-13.568C480.224,136.96,497.728,118.496,512,97.248z"/></svg>
							</a>
						</li>
						<li class="copy">
							<button type="button" class="art-share-icon" data-share-copy aria-label="Sao chép link bài viết" title="Sao chép link">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7A3.1 3.1 0 0 1 3.9 12zM8 13h8v-2H8v2zm9-6h-4v1.9h4a3.1 3.1 0 0 1 0 6.2h-4V17h4a5 5 0 0 0 0-10z"/></svg>
							</button>
						</li>
					</ul>
					<span class="art-share-toast" role="status" aria-live="polite"></span>
				</div>
				<style>
					.art-sharebar{position:relative}
					.art-sharebar .art-share-btn{display:inline-flex;align-items:center;gap:6px;flex-shrink:0;min-width:max-content;white-space:nowrap;height:32px;padding:0 12px;border:0;border-radius:16px;background:#be2326;color:#fff;font-size:13px;font-weight:700;cursor:pointer}
					.art-sharebar .art-share-btn:hover{background:#a01a20}
					.art-sharebar .art-share-btn svg{flex:0 0 16px;width:16px!important;height:16px!important;fill:#fff!important}
					.art-sharebar .art-share-btn svg path{fill:#fff!important}
					.art-sharebar .art-share-icon{display:flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;border:0;background:none;color:#555;cursor:pointer}
					.art-sharebar .art-share-icon:hover{color:#bb2025}
					.art-sharebar .art-share-icon svg{width:20px;height:20px;fill:currentColor}
					.art-share-toast{position:absolute;right:0;top:-6px;transform:translateY(-100%);padding:6px 10px;border-radius:4px;background:#222;color:#fff;font-size:12px;opacity:0;pointer-events:none;transition:opacity .2s}
					.art-share-toast.is-show{opacity:1}
				</style>
				<script>
				(function(){
					var bar=document.querySelector('.art-sharebar[data-share-url]'); if(!bar) return;
					var url=bar.getAttribute('data-share-url'), title=bar.getAttribute('data-share-title'), text=bar.getAttribute('data-share-text');
					var toast=bar.querySelector('.art-share-toast'), tm=0, u=encodeURIComponent(url);
					var fb=bar.querySelector('[data-share-net="fb"]'), x=bar.querySelector('[data-share-net="x"]');
					if(fb) fb.href='https://www.facebook.com/sharer/sharer.php?u='+u;
					if(x) x.href='https://twitter.com/intent/tweet?url='+u+'&text='+encodeURIComponent(title);
					function say(msg){ toast.textContent=msg; toast.classList.add('is-show'); clearTimeout(tm); tm=setTimeout(function(){ toast.classList.remove('is-show'); },2200); }
					function copy(){
						if(navigator.clipboard && window.isSecureContext){ navigator.clipboard.writeText(url).then(function(){ say('Đã sao chép link bài viết'); },function(){ prompt('Sao chép link bài viết:',url); }); }
						else { prompt('Sao chép link bài viết:',url); }
					}
					bar.addEventListener('click',function(e){
						if(e.target.closest('[data-share-copy]')){ copy(); return; }
						if(e.target.closest('[data-share-native]')){
							if(navigator.share){ navigator.share({ title: title, text: text, url: url })['catch'](function(){}); }
							else { copy(); }
						}
					});
				})();
				</script>
				{% endif %}

				<!-- ===== Sản phẩm liên quan ===== -->
				<div class="art-products">
					{% include 'ar-relative-product' %}
				</div>

				<!-- ===== Kêu gọi hành động ===== -->
				<div class="art-cta">
					<div>
						<h2>Cần tư vấn thiết bị bảo hộ phù hợp?</h2>
						<p>Gửi nhu cầu của bạn, đội ngũ D&amp;T sẽ tư vấn và báo giá trong thời gian sớm nhất.</p>
					</div>
					<div class="art-cta-actions">
						<a href="/lien-he" class="art-btn art-btn-primary">Liên hệ ngay</a>
						<a href="/collections/all" class="art-btn art-btn-ghost">Xem sản phẩm</a>
					</div>
				</div>

				<!-- ===== Bài viết liên quan ===== -->
				<section class="art-section art-related" id="artRelated">
					<h2 class="art-h2">Bài viết liên quan</h2>
					<div class="art-related-grid">
						{% assign current_url = article.url %}
						{% assign shown = 0 %}
						{% for article in blog.articles limit: 5 %}
						{% if article.url != current_url and shown < 3 %}
						{% assign shown = shown | plus: 1 %}
						<a class="art-rel-card" href="{{ article.url }}" title="{{ article.title }}">
							<span class="art-rel-thumb">
								{% if article.image == null %}
								<img src="{{ 'no-image.jpg' | asset_url }}" alt="{{ article.title }}" />
								{% else %}
								<img src="{{ 'loaders.svg' | asset_url }}" data-lazyload="{{ article.image.src | img_url:'large' }}" alt="{{ article.title }}" />
								{% endif %}
							</span>
							<span class="art-rel-body">
								<span class="art-rel-date">{{ article.created_on | date:'dd/MM/yyyy' }}</span>
								<span class="art-rel-title">{{ article.title }}</span>
							</span>
						</a>
						{% endif %}
						{% endfor %}
					</div>
				</section>

				<!-- ===== Bình luận ===== -->
				{% if blog.comments_enabled %}
				<section class="art-section art-comments">
					{% if article.comments_count > 0 %}
					{% paginate article.comments by 2 %}
					<div id="article-comments">
						<h2 class="art-h2">Bình luận ({{ article.comments_count }})</h2>
						{% for comment in article.comments %}
						<div class="art-comment">
							<img src="https://www.gravatar.com/avatar/{{ comment.email | remove: ' ' | strip_newlines | downcase | md5 }}?s=55&d=identicon" alt="binh-luan" />
							<div class="art-comment-body">
								<div class="art-comment-head">
									<strong>{{ comment.author }}</strong>
									<span>{{ comment.created_on | date:'dd/MM/yyyy' }}</span>
								</div>
								<p>{{ comment.content }}</p>
							</div>
						</div>
						{% endfor %}
					</div>
					{% if paginate.pages > 1 %}
					<div class="text-center pagging-css">
						{% include 'paginate-pages-article' %}
					</div>
					{% endif %}
					{% endpaginate %}
					{% endif %}

					{% form "article_comments", article %}
					<div class="art-form">
						<h2 class="art-h2">Viết bình luận của bạn</h2>

						{% if form.posted_successfully %}
						{% if blog.moderated %}
						<div class="art-alert art-alert-warn" role="alert">Bình luận của bạn đã được gửi đi, chờ kiểm duyệt.</div>
						{% else %}
						<div class="art-alert art-alert-ok" role="alert">Bình luận của bạn đã được gửi thành công.</div>
						{% endif %}
						{% endif %}
						{% if form.errors.size > 0 %}
						<div class="art-alert art-alert-err">{{ form.errors | default_errors }}</div>
						{% endif %}

						<div class="art-form-row">
							<input placeholder="Họ tên" type="text" class="form-control" value="{{ customer.name }}" id="full-name" name="Author" required data-validation-error-msg="Không được để trống" data-validation="required" />
							<input placeholder="Email" type="email" class="form-control" value="{{ customer.email }}" id="email" name="Email" data-validation="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$" data-validation-error-msg="Email sai định dạng" required />
						</div>
						<textarea placeholder="Nội dung bình luận" class="form-control" id="comment" name="Body" rows="5" required data-validation-error-msg="Không được để trống" data-validation="required">{{ form.body }}</textarea>
						<button type="submit" class="art-submit">Gửi bình luận</button>
					</div>
					{% endform %}
				</section>
				{% endif %}

				<div class="art-fb">
					<div class="fb-comments" data-href="https:{{ store.url }}{{ article.url }}" data-width="100%" data-numposts="5"></div>
				</div>

				<a class="art-back" href="{{ blog.url }}"><i class="fa fa-long-arrow-left" aria-hidden="true"></i> Quay lại {{ blog.name }}</a>
			</article>
		</section>

		{%unless settings.blog_layout == 'no'%}
		<aside class="left left-content col-md-3 {%if settings.blog_layout == 'left'%}col-md-pull-9{%endif%}">
			{% include 'sidebar-blog' %}
		</aside>
		{%endunless%}
	</div>
</div>
<div class="ab-module-article-mostview"></div>
<input class="abbs-article-id" type="hidden" data-article-id="{{article.Id}}">
{% include 'appbulk-selling-products' %}

<style>
html { scroll-behavior: smooth; }

/* ===== Thanh tiến độ đọc ===== */
.art-progress {
	position: fixed;
	top: 0; left: 0;
	z-index: 9999;
	width: 0;
	height: 3px;
	background: #bf2026;
	transition: width .1s linear;
}

/* ===== Đầu bài ===== */
.art-article { padding-bottom: 10px; }
.art-header { margin: 8px 0 26px; }
.art-eyebrow {
	display: inline-block;
	margin-bottom: 14px;
	padding: 4px 12px;
	border-radius: 20px;
	background: #fdecec;
	font-size: 12px;
	font-weight: 600;
	color: #bf2026;
	text-decoration: none;
}
.art-eyebrow:hover { background: #bf2026; color: #fff; }
.art-title {
	margin: 0 0 14px;
	font-size: 32px;
	font-weight: 700;
	line-height: 1.3;
	color: #1d1d1d;
	text-transform: none;
}
.art-meta {
	display: flex;
	flex-wrap: wrap;
	gap: 6px 20px;
	padding-bottom: 18px;
	border-bottom: 1px solid #eee;
	font-size: 13px;
	color: #888;
}
.art-meta .fa { margin-right: 5px; color: #bf2026; }

/* ===== Mục lục ===== */
.art-toc {
	margin: 0 0 28px;
	padding: 18px 22px;
	border: 1px solid #eee;
	border-left: 4px solid #bf2026;
	border-radius: 10px;
	background: #fafafa;
}
.art-toc-title { margin: 0 0 8px; font-size: 15px; font-weight: 700; color: #222; }
.art-toc ol { margin: 0; padding-left: 20px; }
.art-toc li { padding: 4px 0; font-size: 14.5px; line-height: 1.5; }
.art-toc a { color: #444; text-decoration: none; }
.art-toc a:hover { color: #bf2026; text-decoration: underline; }

.art-content {
	font-size: 17px;
	line-height: 1.85;
	color: #333;
	word-wrap: break-word;
}
.art-content p,
.art-content li,
.art-content span,
.art-content div,
.art-content a,
.art-content strong,
.art-content em,
.art-content h1,
.art-content h2,
.art-content h3,
.art-content h4 { font-family: inherit !important; }
.art-content p,
.art-content li {
	margin: 0 0 18px;
	font-size: 17px !important;
	line-height: 1.85 !important;
	color: #333 !important;
	text-align: left !important;
}

/* Chú thích ảnh: đoạn in nghiêng ngay sau ảnh thì căn giữa */
.art-content p:has(> img) + p:has(> em:only-child),
.art-content p:has(> img) + p:has(> i:only-child),
.art-content figure + p:has(> em:only-child) {
	margin-top: -10px;
	font-size: 14px !important;
	font-style: italic;
	color: #777 !important;
	text-align: center !important;
}

/* Cho phép căn giữa bằng nút căn giữa trong trình soạn thảo */
.art-content p[style*="text-align: center"],
.art-content p[style*="text-align:center"] {
	text-align: center !important;
}
	
.art-content span { font-size: inherit !important; color: inherit !important; background: none !important; }
.art-content strong, .art-content b { color: #1d1d1d !important; }
.art-content a { color: #bf2026 !important; text-decoration: underline; }
.art-content a:hover { color: #a01a20 !important; }

.art-content h2 {
	margin: 40px 0 16px;
	padding-left: 14px;
	border-left: 4px solid #bf2026;
	font-size: 26px !important;
	font-weight: 700;
	line-height: 1.35 !important;
	color: #1d1d1d !important;
	text-transform: none;
	scroll-margin-top: 90px;
}
.art-content h3 {
	margin: 30px 0 12px;
	font-size: 21px !important;
	font-weight: 700;
	line-height: 1.4 !important;
	color: #222 !important;
	text-transform: none;
	scroll-margin-top: 90px;
}
.art-content h4 { margin: 24px 0 10px; font-size: 18px !important; font-weight: 700; color: #222 !important; }
.art-content ul, .art-content ol { margin: 0 0 20px; padding-left: 24px; }
.art-content li { margin-bottom: 8px; }
.art-content img {
	display: block;
	max-width: 100%;
	height: auto !important;
	margin: 24px auto;
	border-radius: 10px;
}
.art-content figure { margin: 24px 0; }
.art-content figcaption,
.art-content .caption { margin-top: 8px; font-size: 13px; font-style: italic; color: #888; text-align: center; }
.art-content blockquote {
	margin: 24px 0;
	padding: 16px 22px;
	border-left: 4px solid #bf2026;
	border-radius: 0 10px 10px 0;
	background: #fafafa;
	font-style: italic;
	color: #555;
}
.art-content blockquote p:last-child { margin-bottom: 0; }
.art-content table {
	display: block;
	width: 100%;
	max-width: 100%;
	margin: 24px 0;
	overflow-x: auto;
	border-collapse: collapse;
}
.art-content table th,
.art-content table td { padding: 10px 14px; border: 1px solid #e6e6e6; font-size: 15px; }
.art-content table th { background: #f5f5f5; font-weight: 700; }
.art-content iframe, .art-content video { max-width: 100%; border-radius: 10px; }

/* ===== Tags + chia sẻ ===== */
.art-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 28px 0 0; }
.art-tags-label { font-size: 14px; font-weight: 600; color: #333; }
.art-tags a {
	padding: 5px 14px;
	border: 1px solid #e3e3e3;
	border-radius: 20px;
	font-size: 13px;
	color: #555;
	text-decoration: none;
	transition: all .2s;
}
.art-tags a:hover { border-color: #bf2026; background: #bf2026; color: #fff; }
.art-sharebar {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 12px;
	margin: 22px 0 0;
	padding: 16px 0;
	border-top: 1px solid #eee;
	border-bottom: 1px solid #eee;
}
.art-sharebar-label { font-size: 14px; font-weight: 600; color: #333; }

.art-products { margin-top: 30px; }

/* ===== Mạng xã hội =====*/
.art-sharebar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
}

.art-sharebar-label {
    flex-shrink: 0;
    white-space: nowrap;
}

.art-sharebar ul.art-social {
    display: flex !important;
    align-items: center;
    flex-direction: row !important;
    flex-wrap: nowrap;
    gap: 10px;

    list-style: none;
    margin: 0;
    padding: 0;
}

.art-sharebar .art-social li {
    display: flex;
    float: none !important;
    width: auto !important;
    margin: 0;
    padding: 0;
    flex: 0 0 auto;
}

.art-sharebar .art-social li a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #555;
    text-decoration: none;
}

.art-sharebar .art-social svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
}

.art-sharebar .art-social svg path {
    fill: currentColor;
}

.art-sharebar .art-social a:hover {
    color: #bb2025;
}

/* Mobile */
@media (max-width: 480px) {
    .art-sharebar {
        gap: 8px;
    }

    .art-sharebar ul.art-social {
        gap: 5px;
        min-width: 0;
        overflow-x: auto;
    }

    .art-sharebar .art-social li a {
        width: 28px;
        height: 28px;
    }

    .art-sharebar .art-social svg {
        width: 18px;
        height: 18px;
    }
}
		
	

/* ===== Kêu gọi hành động ===== */
.art-cta {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 20px;
	margin: 34px 0;
	padding: 26px 28px;
	border-radius: 14px;
	background: linear-gradient(135deg, #1f1f1f 0%, #3b1315 100%);
	color: #fff;
}
.art-cta h2 { margin: 0 0 6px; font-size: 20px; font-weight: 700; color: #fff; text-transform: none; }
.art-cta p { margin: 0; font-size: 14px; line-height: 1.55; color: rgba(255, 255, 255, .8); }
.art-cta-actions { display: flex; flex: 0 0 auto; gap: 10px; }
.art-btn {
	display: inline-block;
	padding: 11px 22px;
	border-radius: 8px;
	font-size: 14px;
	font-weight: 600;
	white-space: nowrap;
	text-decoration: none;
	transition: background .2s, color .2s;
}
.art-btn-primary { background: #bf2026; color: #fff; }
.art-btn-primary:hover { background: #a01a20; color: #fff; }
.art-btn-ghost { border: 1px solid rgba(255, 255, 255, .5); color: #fff; }
.art-btn-ghost:hover { background: #fff; color: #1f1f1f; }

/* ===== Tiêu đề khối ===== */
.art-section { margin-top: 36px; }
.art-h2 {
	margin: 0 0 18px;
	padding-left: 12px;
	border-left: 4px solid #bf2026;
	font-size: 20px;
	font-weight: 700;
	line-height: 1.3;
	color: #222;
	text-transform: none;
}

/* ===== Bài viết liên quan ===== */
.art-related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.art-rel-card {
	display: flex;
	flex-direction: column;
	overflow: hidden;
	border: 1px solid #eee;
	border-radius: 12px;
	background: #fff;
	box-shadow: 0 4px 14px rgba(0, 0, 0, .05);
	text-decoration: none;
	transition: transform .25s, box-shadow .25s;
}
.art-rel-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0, 0, 0, .11); }
.art-rel-thumb { display: block; overflow: hidden; aspect-ratio: 16 / 10; background: #f3f3f3; }
.art-rel-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.art-rel-card:hover .art-rel-thumb img { transform: scale(1.06); }
.art-rel-body { display: block; padding: 14px 16px 16px; }
.art-rel-date { display: block; margin-bottom: 6px; font-size: 12px; color: #999; }
.art-rel-title {
	display: -webkit-box;
	-webkit-line-clamp: 3;
	-webkit-box-orient: vertical;
	overflow: hidden;
	font-size: 15px;
	font-weight: 600;
	line-height: 1.45;
	color: #222;
}
.art-rel-card:hover .art-rel-title { color: #bf2026; }

/* ===== Bình luận ===== */
.art-comment { display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px dashed #eee; }
.art-comment img { flex: 0 0 48px; width: 48px; height: 48px; border-radius: 50%; }
.art-comment-body { flex: 1; min-width: 0; }
.art-comment-head { margin-bottom: 4px; }
.art-comment-head strong { margin-right: 10px; font-size: 14px; color: #222; }
.art-comment-head span { font-size: 12px; color: #999; }
.art-comment-body p { margin: 0; font-size: 14px; line-height: 1.65; color: #555; }

.art-form {
	margin-top: 26px;
	padding: 26px;
	border: 1px solid #eee;
	border-radius: 14px;
	background: #fafafa;
}
.art-form-row { display: flex; gap: 14px; margin-bottom: 14px; }
.art-form-row .form-control { flex: 1; min-width: 0; }
.art-form .form-control {
	width: 100%;
	height: 46px;
	padding: 0 14px;
	border: 1px solid #dcdcdc;
	border-radius: 8px;
	background: #fff;
	font-size: 14px;
	box-shadow: none;
	transition: border-color .2s, box-shadow .2s;
}
.art-form textarea.form-control { height: auto; padding: 12px 14px; resize: vertical; }
.art-form .form-control:focus {
	border-color: #bf2026;
	box-shadow: 0 0 0 3px rgba(191, 32, 38, .12);
	outline: none;
}
.art-submit {
	height: 46px;
	margin-top: 14px;
	padding: 0 28px;
	border: 0;
	border-radius: 8px;
	background: #bf2026;
	font-size: 14px;
	font-weight: 700;
	color: #fff;
	cursor: pointer;
	transition: background .2s;
}
.art-submit:hover { background: #a01a20; }
.art-alert { margin-bottom: 14px; padding: 11px 14px; border-radius: 8px; font-size: 13px; line-height: 1.5; }
.art-alert-ok { background: #e8f6ee; color: #1b6b3a; border: 1px solid #bfe3cd; }
.art-alert-warn { background: #fff6e0; color: #8a5a00; border: 1px solid #f0dca4; }
.art-alert-err { background: #fdecec; color: #b42318; border: 1px solid #f7c9c9; }

.art-fb { margin-top: 26px; }
.art-back {
	display: inline-block;
	margin-top: 28px;
	font-size: 14px;
	font-weight: 600;
	color: #bf2026;
	text-decoration: none;
}
.art-back .fa { margin-right: 6px; }
.art-back:hover { color: #a01a20; }


	
/* ===== Sidebar dạng thẻ (dùng chung với trang tin tức) ===== */


/* ===== Responsive ===== */
@media (max-width: 991px) {
	.art-related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.bl-side-card { margin-top: 10px; }
}
@media (max-width: 767px) {
	.art-title { font-size: 24px; }
	.art-content, .art-content p, .art-content li { font-size: 16px !important; }
	.art-content h2 { font-size: 22px !important; }
	.art-content h3 { font-size: 19px !important; }
	.art-cta { flex-direction: column; align-items: flex-start; padding: 22px 20px; }
	.art-form { padding: 20px 16px; }
	.art-form-row { flex-direction: column; }
}
@media (max-width: 575px) {
	.art-related-grid { grid-template-columns: 1fr; }
	.art-cta-actions { flex-wrap: wrap; }
}
</style>

<script type="text/javascript">
(function () {
	var content = document.getElementById('artContent');
	if (!content) return;

	// 1. Thời gian đọc (ước lượng 200 từ/phút)
	var words = (content.textContent || '').trim().split(/\s+/).length;
	var mins = Math.max(1, Math.round(words / 200));
	var read = document.getElementById('artRead');
	if (read) {
		read.querySelector('b').textContent = mins;
		read.style.display = '';
	}

	// 2. Mục lục tự sinh từ các tiêu đề H2 (chỉ hiện khi có từ 3 mục)
	var h2s = content.querySelectorAll('h2');
	var toc = document.getElementById('artToc');
	if (toc && h2s.length >= 3) {
		var ol = toc.querySelector('ol');
		for (var i = 0; i < h2s.length; i++) {
			var h = h2s[i];
			h.id = h.id || ('muc-' + (i + 1));
			var li = document.createElement('li');
			var a = document.createElement('a');
			a.href = '#' + h.id;
			a.textContent = h.textContent.replace(/\s+/g, ' ').trim();
			li.appendChild(a);
			ol.appendChild(li);
		}
		toc.style.display = '';
	}

	// 3. Thanh tiến độ đọc
	var bar = document.getElementById('artProgress');
	function onScroll() {
		if (!bar) return;
		var rect = content.getBoundingClientRect();
		var total = rect.height - window.innerHeight * 0.6;
		var done = Math.min(Math.max(-rect.top + window.innerHeight * 0.2, 0), total);
		bar.style.width = (total > 0 ? (done / total) * 100 : 0) + '%';
	}
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// 4. Ẩn khối "Bài viết liên quan" nếu không có bài nào
	var grid = document.querySelector('.art-related-grid');
	var rel = document.getElementById('artRelated');
	if (grid && rel && !grid.children.length) rel.style.display = 'none';
})();
</script>
